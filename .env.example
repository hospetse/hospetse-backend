PORT=3000
DATABASE_URL=postgresql://postgres:senha@localhost:5432/hospetse?schema=public
# Segredo compartilhado com o Auth Server (mesmo valor nos dois .env). Gerar: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INTERNAL_SERVICE_TOKEN=
# Chave pública RS256 do Auth Server (PEM, entre aspas duplas, pode ter várias linhas). Mesmo valor da JWT_PUBLIC_KEY do Auth
JWT_PUBLIC_KEY=
# Origens do navegador que podem chamar o back-end, separadas por vírgula (Expo web: 8081)
CORS_ORIGINS="http://localhost:8081"
# Bucket do Railway (S3 compatível). Valores na aba Credentials do bucket
S3_BUCKET=
S3_ENDPOINT=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Opcional: validade em segundos dos links temporários de arquivos. Padrão: 300
STORAGE_SIGNED_URL_SECONDS=300
# Stripe em modo de teste (ADR-016). Nunca use chave de produção (sk_live_). Dashboard › Developers › API keys
STRIPE_SECRET_KEY=
# Segredo do webhook (whsec_...): no local, impresso pelo `stripe listen`; no Railway, o do endpoint cadastrado no Dashboard
STRIPE_WEBHOOK_SECRET=
# Opcional: tempo máximo de espera do Stripe, em milissegundos. Padrão: 10000
STRIPE_TIMEOUT_MS=10000
# Percentual da plataforma para novas reservas de hospedagem. Padrão: 10. Use ponto nos decimais.
RESERVATION_PLATFORM_FEE_PERCENT=10

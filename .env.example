PORT=3000
DATABASE_URL=postgresql://postgres:senha@localhost:5432/hospetse?schema=public
# Segredo compartilhado com o Auth Server (mesmo valor nos dois .env). Gerar: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INTERNAL_SERVICE_TOKEN=
# Chave pública RS256 do Auth Server (PEM, entre aspas duplas, pode ter várias linhas). Mesmo valor da JWT_PUBLIC_KEY do Auth
JWT_PUBLIC_KEY=
